 create or replace TEMP table `battery_data` as ( select distinct
    _e AS serialnumber,CONCAT(battery_partnumber, battery_manufacturing_date, battery_serial_number) AS bid,
    extract(date from TIMESTAMP_MILLIS(_r)) AS device_date,
    extract(hour from TIMESTAMP_MILLIS(_r)) as device_hour,
    extract(minute from TIMESTAMP_MILLIS(_r)) as device_min,
    battery_level,ac_line_status,
    COUNT(DISTINCT(_e)) OVER(PARTITION BY EXTRACT(date FROM TIMESTAMP_MILLIS(_r))) AS total_sn_cnt,
    first_value(battery_level) over (partition by _e,extract(date from TIMESTAMP_MILLIS(_r)),extract(hour from TIMESTAMP_MILLIS(_r))  
    order by extract(minute from TIMESTAMP_MILLIS(_r)) ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as first_battery_val,
    last_value(battery_level) over (partition by _e,extract(date from TIMESTAMP_MILLIS(_r)),extract(hour from TIMESTAMP_MILLIS(_r))  
    order by extract(minute from TIMESTAMP_MILLIS(_r)) ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as last_battery_val
  FROM
    `es-s2dl-core-p.emc_eu.t_zagent_battery`
  WHERE
    DATE(_et) between  "2024-09-01" and  "2024-09-30"
    AND DATE(TIMESTAMP_MILLIS(_r)) BETWEEN "2024-09-01" and  "2024-09-30"
  --  and _e in ("22168522519775" )
   and ac_line_status >=0
    AND CONCAT(battery_partnumber, battery_manufacturing_date, battery_serial_number) != "UnknownUnknownUnknown"
  ORDER BY serialnumber,device_date, device_hour,device_min asc);


create or replace TEMP table `battery_data_1` as (
  select a.*,b.company_name,b.master_id,b.site_name,b.model_number,b.total_device_cnt_by_model,
  b.total_device_cnt_by_site
  from battery_data as a inner join asda_site_data as b
  on a.serialnumber = b.serial_number 
  order by serialnumber,device_date, device_hour,device_min ASC
 );

-- Create variables to get count of devices by site,model_number and at overall site level after joining with ZDS tables.
create or replace TEMP table `battery_data_1_1` as (
  select *, COUNT(DISTINCT(serialnumber)) OVER(PARTITION BY site_name,model_number) AS total_device_cnt_by_model_matchZDS,
  COUNT(DISTINCT(serialnumber)) OVER(PARTITION BY site_name) AS total_device_cnt_by_site_matchZDS,
  COUNT(DISTINCT(bid)) OVER(PARTITION BY site_name,model_number) AS total_bid_cnt_by_model_matchZDS,
  COUNT(DISTINCT(bid)) OVER(PARTITION BY site_name) AS total_bid_cnt_by_site_matchZDS

  from battery_data_1
  order by serialnumber,device_date, device_hour,device_min ASC
 );


create or replace TEMP table `battery_data_site` as (
select * ,
CASE
      WHEN (batt_chng  = 1
        and prev_battery_level >89 )   THEN 'Testing-Charge'
      WHEN (batt_chng  = 1
        and prev_battery_level between 15 and 89 )   THEN 'Inappropriate swap'
      WHEN (batt_chng  = 1
        and prev_battery_level < 15  )   THEN 'Appropriate swap'
    ELSE
     'No swap'
    END AS batt_swap
from (
select site_name,serialnumber,bid,device_date,device_hour,device_min,battery_level,ac_line_status,last_battery_val,
model_number,total_device_cnt_by_model,total_device_cnt_by_site,total_device_cnt_by_model_matchZDS,
total_device_cnt_by_site_matchZDS,total_bid_cnt_by_model_matchZDS,total_bid_cnt_by_site_matchZDS,
 (LAG(serialnumber)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) as  prev_serialnumber,
  (LAG(bid)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) as  prev_bid,
  (LAG(device_date)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) as  prev_device_date,
  (LAG(device_hour)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) as  prev_device_hour,
  (LAG(device_min)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) as  prev_device_min,
  (LAG(ac_line_status)  over (order by site_name,serialnumber,device_date,device_hour,device_min,bid) ) as  prev_ac_line_status,
   (LAG(battery_level)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) as  prev_battery_level,
   CASE
      WHEN (bid  != (LAG(bid)  over (order by site_name,serialnumber,device_date,device_hour,device_min) )
        and serialnumber = (LAG(serialnumber)  over (order by site_name,serialnumber,device_date,device_hour,device_min) ) )  THEN 1
    ELSE
     0
    END AS batt_chng

   from battery_data_1_1
    ORDER BY site_name,serialnumber,device_date, device_hour,device_min ASC)
  ORDER BY site_name,serialnumber,device_date, device_hour,device_min ASC);

