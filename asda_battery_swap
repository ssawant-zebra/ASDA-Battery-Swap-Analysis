create or replace TEMP table asda_site_data as (
  select *, COUNT(DISTINCT(serial_number)) OVER(PARTITION BY site_name,model_number) AS total_device_cnt_by_model,
  COUNT(DISTINCT(serial_number)) OVER(PARTITION BY site_name) AS total_device_cnt_by_site from(
