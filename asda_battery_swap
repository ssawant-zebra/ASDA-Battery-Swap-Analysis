create or replace TEMP table `cte` as (
select site_name,year_month1,model_number,count(*) as inapp_swap from ( 
select *,format_date('%Y-%m', device_date) as year_month1 from `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.asda_swap_24hrs_new` )
where batt_swap3 = "Inappropriate swap"  
-- and site_name = "240-Chester DO"
group by site_name,year_month1,model_number
order by site_name,year_month1,model_number);

create or replace TEMP table `cte1` as (  
     select * from (select *, 
                   row_number() 
                     over(partition by site_name,threshold_filter order by year_month1 ) rn from cte));



create or replace TEMP table `cte2` as (select c1.site_name, 
       c1.year_month1,c1.model_number,
       c1.inapp_swap, sum(c1.inapp_swap) OVER(PARTITION BY c1.site_name) AS total_inapp_swap,
       case when c1.inapp_swap > c2.inapp_swap then 'up'
            when c1.inapp_swap < c2.inapp_swap then 'down'
            when c1.inapp_swap = c2.inapp_swap then 'equal'
       end as Trend
from cte1 c1
left join cte1 c2 on c1.site_name = c2.site_name and c1.model_number = c2.model_number and c1.rn-1 = c2.rn
order by site_name,model_number);


-- Change 1 to 4 to track last 4 month increasing trend
create or replace TEMP table `cte3` as (select *, '1' as trend_flag from 
(select site_name,model_number,max(total_inapp_swap) as total_inapp_swap, count(*) as ctrend from cte2
where Trend in ('up') group by site_name,model_number) where ctrend >=2 );

create or replace table `dmsanlytc-cssanlytc-eu-d.TEST_DATA_EU_SS.asda_swap_trend_24hrs_new` as (select c1.*,c2.trend_flag
from cte2 as c1 inner join cte3 as c2 
on c1.site_name = c2.site_name and c1.model_number=c2.model_number
order by total_inapp_swap desc,year_month1,model_number);

